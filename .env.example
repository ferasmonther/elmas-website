# Canonical production origin. Vercel production uses this origin even if SITE_URL is absent.
SITE_URL=https://www.elmasbio.com
# Local/non-Vercel builds default to preview. Set SITE_ENV=production only for a production build.
# VERCEL_ENV takes precedence: Vercel preview/development deployments always stay noindex.
SITE_ENV=preview
# Confirmed public business contacts. Use international digits for WhatsApp.
CONTACT_EMAIL=ferasmonther@elmasbio.com
WHATSAPP_NUMBER=96170988141
# Server-only SMTP settings. Use port 587 (STARTTLS) or 465 (TLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=ferasmonther@elmasbio.com
# Optional: only a header overwritten by your trusted reverse proxy.
# Otherwise all visitors share a conservative five-attempt/15-minute limit.
TRUSTED_CLIENT_IP_HEADER=
